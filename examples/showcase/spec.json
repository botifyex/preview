{
  "environment": "local",
  "base_url": "http://127.0.0.1:8000",
  "locale": "en-US",
  "hide": [
    ".dev-overlay:not(.pinned)"
  ],
  "login": {
    "name": "showcase-user",
    "steps": [
      {
        "action": "goto",
        "url": "/login.html"
      },
      {
        "action": "fill",
        "target": {
          "role": "textbox",
          "name": "Email"
        },
        "value": "demo@mossbill.example"
      },
      {
        "action": "fill",
        "target": {
          "role": "textbox",
          "name": "Password"
        },
        "value_env": "SHOWCASE_PASSWORD"
      },
      {
        "action": "click",
        "target": {
          "role": "button",
          "name": "Sign in"
        }
      }
    ],
    "expect": {
      "role": "heading",
      "name": "Dashboard"
    }
  },
  "figures": [
    {
      "slug": "mark-box",
      "url": "/index.html",
      "viewport": {
        "width": 1024,
        "height": 640
      },
      "full_page": false,
