    {
      "slug": "steps-to-hover",
      "url": "/index.html",
      "viewport": {
        "width": 1024,
        "height": 640
      },
      "full_page": false,
      "steps": [
        {
          "action": "goto",
          "url": "/invoices.html"
        },
        {
          "action": "fill",
          "target": {
            "role": "searchbox",
            "name": "Search invoices"
          },
          "value": "Fictional"
        },
        {
          "action": "press",
          "target": {
            "role": "searchbox",
            "name": "Search invoices"
          },
          "key": "Enter"
        },
        {
          "action": "wait",
          "target": {
            "text": "1 invoice"
          }
        },
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "^Overdue",
            "match": "regex"
          }
        },
        {
          "action": "wait",
          "milliseconds": 50
        },
        {
          "action": "hover",
          "target": {
            "text": "^INV-10\\d+$",
            "match": "regex"
          }
        }
      ],
      "annotations": [
        {
          "kind": "box",
          "anchor": {
            "selector": "tr[data-number='INV-1042'] .row-buttons"
          },
          "number": 1
        }
      ]
    },
    {
      "slug": "scheme-checkout-path",
      "viewport": {
        "width": 380,
        "height": 440
      },
      "gap": 56,
      "steps_numbers": true,
      "links": "sequence",
      "continuous": true,
      "panels": [
        {
          "url": "/addons.html",
          "title": "Add a service",
          "steps": [
            {
              "action": "click",
              "target": {
                "role": "button",
                "name": "Add Reminder emails"
              }
            }
          ],
          "annotations": [
            {
              "kind": "box",
              "anchor": {
                "role": "link",
                "name": "Cart (1)"
              }
            }
          ]
        },
        {
          "title": "Check the cart",
          "steps": [
            {
              "action": "click",
              "target": {
                "role": "link",
                "name": "Cart (1)"
              }
            }
          ],
          "annotations": [
            {
              "kind": "highlight",
              "anchor": {
                "role": "row",
                "name": "Reminder emails",
                "match": "substring"
              }
            }
          ]
        },
        {
          "title": "Place the order",
          "steps": [
            {
              "action": "click",
              "target": {
                "role": "button",
                "name": "Place order"
              }
            }
          ],
          "annotations": [
            {
              "kind": "box",
              "anchor": {
                "selector": ".confirmation"
              }
            }
          ]
        }
      ]
    },
    {
      "slug": "scheme-invoice-parts",
      "viewport": {
        "width": 1024,
        "height": 640
      },
      "layout": "column",
      "panels": [
        {
          "url": "/invoice.html?id=INV-1042",
