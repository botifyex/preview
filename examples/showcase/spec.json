          "title": "Invoices"
        },
        {
          "id": "settings",
          "url": "/settings.html",
          "title": "Settings"
        },
        {
          "id": "invoice",
          "url": "/invoice.html?id=INV-1048",
          "title": "One invoice"
        }
      ],
      "links": [
        {
          "from": "dashboard",
          "to": "invoices",
          "from_mark": 1,
          "text": "Go to invoices"
        },
        {
          "from": "invoices",
          "to": "invoice",
          "text": "Pick one"
        },
        {
          "from": "invoice",
          "to": "settings",
          "style": "dashed",
          "text": "Optional"
